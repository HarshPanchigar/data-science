    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "arr = np.arange(1 , 17).reshape(4,4)\n",
    "print(arr)\n",
    "\n",
    "diagonal = np.diag(arr)\n",
    "print(diagonal)\n",
    "\n",
    "series = pd.Series(diagonal , index=[\"A\",\"B\",\"C\",\"D\"])\n",
    "print(series)\n",
    "\n",
    "print(type(series))"
